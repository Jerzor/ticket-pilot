# systemd --user unit for the web dashboard + chat
# install: cp deploy/ticket-pilot-web.service ~/.config/systemd/user/ && systemctl --user enable --now ticket-pilot-web
[Unit]
Description=Ticket Pilot web dashboard

[Service]
ExecStart=/usr/bin/python3 %h/path/to/ticket-pilot/web/server.py
Restart=on-failure

[Install]
WantedBy=default.target
